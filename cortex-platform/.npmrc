# Puppeteer normally downloads its own bundled Chromium during "npm install".
# On a locked-down network (like this sandbox, or some shared hosting setups)
# that download can fail. Setting this to true skips it - you must then
# either remove this line (to let it download normally on your real server),
# or install Google Chrome separately and set PUPPETEER_EXECUTABLE_PATH in .env
# to point at it (e.g. /usr/bin/google-chrome-stable).
puppeteer_skip_download=true
