# ==============================
# CORTEX PLATFORM - ENVIRONMENT
# Copy this file to ".env" and fill in real values.
# Never commit the real ".env" file.
# ==============================

# --- Server ---
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000

# --- JWT Auth ---
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=replace_this_with_another_long_random_string
JWT_REFRESH_EXPIRES_IN=30d

# --- MongoDB (crawl lake: pages, backlinks, SERPs, logs, AI citations, social) ---
MONGO_URI=mongodb://127.0.0.1:27017/cortex_crawl_lake

# --- SQL (system of record: users, workspaces, sites, billing, rank history) ---
# Set SQL_DIALECT to either "mysql" or "postgres" - the same models/code
# work with both, only this value and the connection details change.
SQL_DIALECT=mysql
SQL_HOST=127.0.0.1
SQL_PORT=3306
SQL_DATABASE=cortex_core
SQL_USERNAME=root
SQL_PASSWORD=

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=300

# --- Redis (required for the crawl job queue - BullMQ) ---
REDIS_URL=redis://127.0.0.1:6379

# --- Crawl Engine (Phase 2) ---
# Identifies which region/data-center this worker process is running in.
# Run the same worker.js on multiple servers with different values here
# to get true multi-region distributed crawling.
CRAWL_WORKER_REGION=ap-south-1
CRAWL_MAX_PAGES_PER_SITE=200
CRAWL_CONCURRENCY=5
CRAWL_REQUEST_TIMEOUT_MS=20000
# Leave blank to use Puppeteer's bundled Chromium.
# Set this if you skipped the Chromium download (see .npmrc) and are
# using a system-installed Google Chrome instead.
PUPPETEER_EXECUTABLE_PATH=

# --- Keyword Intelligence / Rank Tracking (Phase 3) ---
# "api"       -> use a licensed third-party SERP API (recommended for real tracking)
# "puppeteer" -> local dev/testing fallback that scrapes Google directly (see
#                services/serp/puppeteerGoogleProvider.js for its limitations)
SERP_PROVIDER=puppeteer
SERP_API_URL=
SERP_API_KEY=

# --- Backlink Engine (Phase 4) ---
# Licensed backlink data API (Ahrefs/Moz/Majestic-style). If you don't
# have one yet, use the CSV import endpoint instead - it works with
# exports from any of those tools without needing an API key.
BACKLINK_API_URL=
BACKLINK_API_KEY=

# --- Outreach (Phase 4) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Shared secret your email provider must send back on inbound-reply
# webhook calls (see routes/webhook.routes.js). Generate any long random string.
OUTREACH_WEBHOOK_SECRET=replace_this_with_a_long_random_string

# --- AEO/GEO Lab (Phase 5) ---
# Only the engines with a key set here get checked in citation runs.
# Add either or both - see services/aeo/llmProviders/.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_API_URL=
OPENAI_MODEL=gpt-4o-mini

# --- SMO Suite (Phase 5) ---
# Point this at a Zapier "Catch Hook" / Make.com webhook (or your own
# middleware) that fans out to each real social platform using ITS OWN
# OAuth connections - see services/smo/webhookSocialProvider.js for why.
SMO_PUBLISH_WEBHOOK_URL=

# --- Local SEO / Google Business Profile (Phase 6) ---
# Requires a Google Cloud project with Business Profile API access
# (Google reviews each access request - not self-serve) and a completed
# OAuth consent flow. See services/local/gbpProvider.js and the
# developer guide for the setup steps.
GBP_CLIENT_ID=
GBP_CLIENT_SECRET=
GBP_REFRESH_TOKEN=

# ==============================================================
# Phase 7 - Own Your Data: free official integrations + the agent
# No paid third-party SEO/SERP/backlink/LLM API is required for any
# of this. Everything below is either a free official platform API
# (Google/Bing, at no cost) or a genuinely open, self-hosted option.
# ==============================================================

# --- Google integrations (Search Console, Analytics 4, Tag Manager) ---
# One shared OAuth setup - see DEVELOPER_GUIDE.md for the Google Cloud
# Console steps (free; no billing account needed for these specific APIs).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/integrations/google/callback

# --- PageSpeed Insights (free API key, real Chrome UX field data) ---
PAGESPEED_API_KEY=

# --- IndexNow (open protocol, no account, no OAuth) ---
# Generate one via GET /integrations/indexnow/generate-key, then host
# it at https://yourdomain.com/<key>.txt before setting this.
INDEXNOW_KEY=

# --- Bing Webmaster Tools (free API key) ---
BING_WEBMASTER_API_KEY=

# --- Self-hosted AI Agent (optional local LLM via Ollama) ---
# The agent works fully with NONE of this set - template-based
# suggestions are the default for everyone. Only fill these in if you
# want richer natural-language summaries from a model running on your
# own hardware, genuinely free forever (see services/agent/localLlmProvider.js).
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.1
